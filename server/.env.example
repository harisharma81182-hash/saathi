# Copy this file to .env (same folder) and fill in the values.
# .env is ignored by git, so your secrets never reach GitHub.

# Your MongoDB Atlas connection string (Atlas -> Connect -> Drivers).
# Replace <password> with your database user's password and keep /saathi before the "?".
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/saathi?retryWrites=true&w=majority

# A long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts
JWT_EXPIRES_IN=7d

PORT=4000

# web = HTTP only, worker = background jobs only, all = both (default; right for one instance)
PROCESS_ROLE=all

# MongoDB connections per instance. (instances x this) must stay under your cluster's limit (Atlas free: 500)
MONGO_MAX_POOL=10

LOG_LEVEL=info

# Where the frontend runs in development
CLIENT_ORIGIN=http://localhost:5173

# Which AI powers Saathi: gemini (free tier, the default) or anthropic (Claude)
AI_PROVIDER=gemini

# Gemini API key from aistudio.google.com -> Get API key ("AQ." keys from 2026, older ones "AIza").
# Paste ONLY the key itself: one word, no quotes, no spaces, no code around it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: a second model to try when the main one is overloaded (5xx)
# GEMINI_FALLBACK_MODEL=

# Claude API key from console.anthropic.com (only used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-5-5

# AI timeouts: one attempt gives up after 20 s; one AI call, retries included, after 28 s.
AI_REQUEST_TIMEOUT_MS=20000
AI_TOTAL_TIMEOUT_MS=28000

# Chat messages per user. Generous on purpose: only spam should ever hit these.
AI_USER_PER_MINUTE=20
AI_USER_PER_DAY=300

# AI requests for the whole app, all users together (0 = no limit). Keep these a bit below your
# provider's project limit. Gemini free tier for gemini-3.8-flash: 20 requests/day per project
# (check yours at ai.dev/rate-limit). Defaults: 8/minute and 18/day with gemini, none with anthropic.
AI_GLOBAL_PER_MINUTE=8
AI_GLOBAL_PER_DAY=18

# Limits on AI calls per instance (see docs/SCALING.md). Defaults are fine to start with.
# AI_MAX_CONCURRENCY=8
# AI_MAX_QUEUE=50

# Optional: a separate database for the automated tests (it gets wiped on every test run)
# MONGODB_URI_TEST=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/saathi_test?retryWrites=true&w=majority
