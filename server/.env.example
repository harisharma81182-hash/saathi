# Copy this file to .env (same folder) and fill in the values.
# .env is ignored by git, so your secrets never reach GitHub.

# Your MongoDB Atlas connection string (Atlas -> Connect -> Drivers).
# Replace <password> with your database user's password and keep /saathi before the "?".
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/saathi?retryWrites=true&w=majority

# A long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts
JWT_EXPIRES_IN=7d

PORT=4000

# web = HTTP only, worker = background jobs only, all = both (default; right for one instance)
PROCESS_ROLE=all

# MongoDB connections per instance. (instances x this) must stay under your cluster's limit (Atlas free: 500)
MONGO_MAX_POOL=10

LOG_LEVEL=info

# Where the frontend runs in development
CLIENT_ORIGIN=http://localhost:5173

# Which AI powers Saathi: gemini (free tier, the default) or anthropic (Claude)
AI_PROVIDER=gemini

# Gemini API key from aistudio.google.com -> Get API key ("AQ." keys from 2026, older ones "AIza").
# Paste ONLY the key itself: one word, no quotes, no spaces, no code around it.
GEMINI_API_KEY=
# Models to use, in order. When one reaches its limit (or is overloaded), the next one answers.
# Exact IDs from the models list API; all three support function calling.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash

# Claude API key from console.anthropic.com (only used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-5-5

# AI timeouts: one attempt gives up after 20 s; one AI call, retries included, after 28 s.
AI_REQUEST_TIMEOUT_MS=20000
AI_TOTAL_TIMEOUT_MS=28000

# Chat messages per user. Generous on purpose: only spam should ever hit these.
AI_USER_PER_MINUTE=20
AI_USER_PER_DAY=300

# AI requests per model for the whole app, all users together: model=perMinute/perDay.
# Keep them a bit below the free-tier limits shown at ai.dev/rate-limit (on 18 Oct 2026:
# 3.5 and 3.1 Flash Lite 15 RPM / 500 RPD, 3.8 Flash 5 RPM / 20 RPD). Models not listed: no limit.
AI_MODEL_LIMITS=gemini-3.5-flash-lite=13/480,gemini-3.1-flash-lite=13/480,gemini-3.8-flash=4/18

# Limits on AI calls per instance (see docs/SCALING.md). Defaults are fine to start with.
# AI_MAX_CONCURRENCY=8
# AI_MAX_QUEUE=50

# Email for "Password bhool gaye?" links. Leave SMTP_HOST empty while developing: the reset link is
# then printed in the server log instead of being emailed. Gmail: smtp.gmail.com, port 465,
# SMTP_SECURE=true, your Gmail address, and a Gmail App Password (not your normal password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=
# MAIL_FROM=yourname@gmail.com
# On Render's free plan the SMTP ports are blocked, so use Brevo's HTTP API instead (free, 300 a day):
# brevo.com -> SMTP & API -> API keys. Verify MAIL_FROM as a sender in Brevo. When set, SMTP is not used.
# BREVO_API_KEY=
# Resend (resend.com, free) is used first when set: resend.com -> API Keys -> Create (Sending access).
# Without your own verified domain the sender is onboarding@resend.dev and mail reaches only the
# email of the Resend account owner. MAIL_FROM is used only if it is on a domain verified in Resend.
# RESEND_API_KEY=

# "Continue with Google": OAuth Web Client ID from Google Cloud Console (APIs & Services ->
# Credentials). Authorized JavaScript origins: http://localhost:5173 and your live address;
# Authorized redirect URIs: the same two addresses with a trailing slash (http://localhost:5173/).
# Not a secret. Leave empty to hide the Google button.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Where the app is opened, for links in emails (default: CLIENT_ORIGIN)
# APP_URL=http://localhost:5173

# Optional: a separate database for the automated tests (it gets wiped on every test run)
# MONGODB_URI_TEST=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/saathi_test?retryWrites=true&w=majority

# Web Push notifications (phone and computer, even with the tab closed).
# Make a key pair once:  npx web-push generate-vapid-keys   and paste both keys here.
# VAPID_SUBJECT is a contact the push services can reach (mailto: or your https URL).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
